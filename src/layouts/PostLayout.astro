---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const formatted = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title + ' · Lecheeel'} description={description} type="article">
  <article>
    <header class="mb-10 border-b border-slate-200 pb-8 dark:border-slate-800">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{title}</h1>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
        <time datetime={pubDate.toISOString()}>{formatted}</time>
        {
          updatedDate && (
            <span> · 更新于 {updatedDate.toLocaleDateString('zh-CN')}</span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {
              tags.map((t) => (
                <span
                  class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300"
                >#{t}</span>
              ))
            }
          </div>
        )
      }
    </header>
    <div class="prose prose-slate max-w-none dark:prose-invert">
      <slot />
    </div>
  </article>
</Base>
