---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Lecheeel — developer, writer, builder.',
  image = '/avatar.svg',
  type = 'website',
} = Astro.props;
const SITE = 'https://lecheeel.github.io';
const canonical = new URL(Astro.url.pathname, SITE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Lecheeel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + image} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
    <script is:inline>
      // prevent FOUC on first paint: user choice wins, else system pref
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script>
      // <html> class is reset on view-transition navigation,
      // so re-apply the theme on astro:page-load (first paint + every nav)
      const applyTheme = () => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle(
          'dark',
          stored === 'dark' || (!stored && prefersDark),
        );
      };

      document.addEventListener('astro:page-load', applyTheme);
      applyTheme();

      // theme toggle: event delegation survives navigation
      document.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (!target.closest('#theme-toggle')) return;
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </head>
  <body
    class="bg-white text-slate-800 antialiased transition-colors duration-300 dark:bg-slate-950 dark:text-slate-200"
  >
    <Header />
    <main class="mx-auto w-full max-w-2xl px-5 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
