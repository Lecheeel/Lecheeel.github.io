---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Not Found" description="Page not found">
  <section class="py-16 text-center">
    <p class="font-mono text-sm text-slate-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-slate-900 dark:text-white">
      nothing here
    </h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      the page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-md bg-accent/10 px-4 py-2 text-sm font-medium text-accent transition-colors hover:bg-accent/20"
    >
      back home
    </a>
  </section>
</Base>
