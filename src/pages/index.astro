---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lecheeel',
  url: 'https://lecheeel.github.io',
  email: 'mailto:ryancuee@gmail.com',
  sameAs: ['https://github.com/Lecheeel'],
});
---

<Base
  title="Lecheeel"
  description="Lecheeel — developer, writer, builder."
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />

  <section>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      Lecheeel
    </h1>
    <p class="mt-8 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
      Research notes. Mostly systems and security things I build myself:
      how they work, the numbers from running them, and the parts that
      are still unsolved.
    </p>

    <p class="mt-10 font-semibold text-slate-700 dark:text-slate-300">
      currently working on:
    </p>
    <ul class="mt-2 space-y-1 text-slate-600 dark:text-slate-400">
      <li>an end-to-end encrypted notification pipeline (Android → server → agent memory)</li>
      <li>deterministic multi-agent simulation, replay as a research method</li>
      <li>kernel-level GNSS position forgery: models and a Rust module design</li>
      <li>a spaced-repetition study app with the FSRS v6 scheduler</li>
    </ul>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">writing</h2>
      <a href="/blog/" class="font-mono text-xs text-accent transition-colors hover:text-accent/70">all →</a>
    </div>
    <ul class="space-y-4">
      {
        posts.map((p) => (
          <li>
            <a
              href={'/blog/' + p.id + '/'}
              class="group block rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
            >
              <h3 class="font-medium text-slate-900 transition-colors group-hover:text-accent dark:text-white">
                {p.data.title}
              </h3>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
              <p class="mt-2 text-xs text-slate-400">
                {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">projects</h2>
      <a href="/projects/" class="font-mono text-xs text-accent transition-colors hover:text-accent/70">all →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href={p.data.repo ?? p.data.url ?? '/projects/'}
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
          >
            <h3 class="font-medium text-slate-900 dark:text-white">{p.data.title}</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {
                p.data.stack.map((s) => (
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                    {s}
                  </span>
                ))
              }
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
