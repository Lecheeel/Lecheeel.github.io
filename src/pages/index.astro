---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lecheeel',
  url: 'https://lecheeel.github.io',
  email: 'mailto:ryancuee@gmail.com',
  sameAs: ['https://github.com/Lecheeel'],
});
---

<Base
  title="Lecheeel — 开发者个人主页"
  description="Lecheeel 的个人主页：技术笔记、开源项目与生活分享。Astro 7 + Tailwind 4 构建。"
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />

  <section class="flex items-center gap-6">
    <img
      src="/avatar.svg"
      alt="Lecheeel 头像"
      width="96"
      height="96"
      class="h-24 w-24 shrink-0 rounded-3xl shadow-lg"
    />
    <div>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Hi, I'm Lecheeel <span class="inline-block animate-pulse">👋</span>
      </h1>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        开发者 · 技术爱好者 · 拥抱前沿技术
      </p>
    </div>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">最新文章</h2>
      <a href="/blog/" class="text-sm text-accent transition-colors hover:text-accent/70">查看全部 →</a>
    </div>
    <ul class="space-y-4">
      {
        posts.map((p) => (
          <li>
            <a
              href={'/blog/' + p.id + '/'}
              class="group block rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
            >
              <h3 class="font-medium text-slate-900 transition-colors group-hover:text-accent dark:text-white">
                {p.data.title}
              </h3>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
              <p class="mt-2 text-xs text-slate-400">
                {p.data.pubDate.toLocaleDateString('zh-CN')}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">精选项目</h2>
      <a href="/projects/" class="text-sm text-accent transition-colors hover:text-accent/70">查看全部 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href={p.data.url ?? '/projects/'}
            target={p.data.url ? '_blank' : undefined}
            rel={p.data.url ? 'noopener' : undefined}
            class="rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
          >
            <h3 class="font-medium text-slate-900 dark:text-white">{p.data.title}</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {
                p.data.stack.map((s) => (
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                    {s}
                  </span>
                ))
              }
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
