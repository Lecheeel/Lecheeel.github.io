---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lecheeel',
  url: 'https://lecheeel.github.io',
  email: 'mailto:ryancuee@gmail.com',
  sameAs: ['https://github.com/Lecheeel'],
});
---

<Base
  title="Lecheeel"
  description="Embedded systems and software: FPGA control, ultrasonic phased arrays, PCB design, and Android internals."
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />

  <section>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      Lecheeel
    </h1>

    <p class="mt-8 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
      Hi, I'm Lecheeel. I work on embedded systems and software, with a focus
      on FPGA-based control, ultrasonic phased arrays, and Android internals.
    </p>

    <p class="mt-4 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
      On the embedded side, I'm exploring FPGA-based multichannel phase synthesis, synchronized waveform generation, and acoustic field modeling for three-dimensional manipulation. My interests also include microcontroller firmware, multichannel driver circuits, and high-speed PCB layout, particularly differential pair routing, impedance control, and signal integrity.
    </p>

    <p class="mt-4 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
      On the software side, I'm studying Android internals through AOSP, framework services, Binder IPC, and HAL interfaces. Related interests include GNSS data processing, NMEA parsing, and Android's Generic Kernel Image (GKI), with attention to kernel modules, KMI compatibility, and how requests cross application, framework, and hardware boundaries.
    </p>

    <p class="mt-4 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
      I share selected projects and technical notes here, covering their design,
      implementation, and experimental results.
    </p>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">writing</h2>
      <a href="/blog/" class="font-mono text-xs text-accent transition-colors hover:text-accent/70">all →</a>
    </div>
    <ul class="space-y-4">
      {
        posts.map((p) => (
          <li>
            <a
              href={'/blog/' + p.id + '/'}
              class="group block rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
            >
              <h3 class="font-medium text-slate-900 transition-colors group-hover:text-accent dark:text-white">
                {p.data.title}
              </h3>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
              <p class="mt-2 text-xs text-slate-400">
                {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">projects</h2>
      <a href="/projects/" class="font-mono text-xs text-accent transition-colors hover:text-accent/70">all →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href={p.data.repo ?? p.data.url ?? '/projects/'}
            target="_blank"
            rel="noopener"
            class="rounded-xl border border-slate-200 p-4 transition-colors hover:border-accent/50 dark:border-slate-800"
          >
            <h3 class="font-medium text-slate-900 dark:text-white">{p.data.title}</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {
                p.data.stack.map((s) => (
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                    {s}
                  </span>
                ))
              }
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
