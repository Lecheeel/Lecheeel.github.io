---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Base title="Blog · Lecheeel" description="Writing by Lecheeel">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">blog</h1>
  <p class="mt-4 text-slate-600 dark:text-slate-400">
    things that surprised me, in writing.
  </p>

  <ul class="mt-10 space-y-6">
    {
      posts.map((p) => (
        <li>
          <a href={'/blog/' + p.id + '/'} class="group block">
            <h2 class="text-lg font-medium text-slate-900 transition-colors group-hover:text-accent dark:text-white">
              {p.data.title}
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
            <p class="mt-1.5 font-mono text-xs text-slate-400">
              {p.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
