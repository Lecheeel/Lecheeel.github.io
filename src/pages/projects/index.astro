---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Projects · Lecheeel" description="Open source projects by Lecheeel">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">projects</h1>
  <p class="mt-4 text-slate-600 dark:text-slate-400">
    things i built because i needed them.
  </p>

  <div class="mt-10 grid gap-4">
    {
      projects.map((p) => (
        <a
          href={p.data.repo ?? p.data.url ?? '#'}
          target="_blank"
          rel="noopener"
          class="block rounded-xl border border-slate-200 p-5 transition-colors hover:border-accent/50 dark:border-slate-800"
        >
          <h2 class="font-medium text-slate-900 dark:text-white">{p.data.title}</h2>
          <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
          {p.data.stack?.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {p.data.stack.map((s) => (
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                  {s}
                </span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </div>
</Base>
