---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="项目 · Lecheeel" description="Lecheeel 的开源项目">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">项目</h1>
  <p class="mt-2 text-slate-500 dark:text-slate-400">我参与开发的一些项目。</p>
  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      projects.map((p) => (
        <div class="flex flex-col rounded-xl border border-slate-200 p-5 transition-colors hover:border-accent/50 dark:border-slate-800">
          <h2 class="font-semibold text-slate-900 dark:text-white">{p.data.title}</h2>
          <p class="mt-1 flex-1 text-sm text-slate-500 dark:text-slate-400">{p.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {
              p.data.stack.map((s) => (
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                  {s}
                </span>
              ))
            }
          </div>
          <div class="mt-4 flex gap-4 text-sm">
            {
              p.data.repo && (
                <a href={p.data.repo} target="_blank" rel="noopener" class="text-accent transition-colors hover:text-accent/70">源码 ↗</a>
              )
            }
            {
              p.data.url && (
                <a href={p.data.url} target="_blank" rel="noopener" class="text-accent transition-colors hover:text-accent/70">演示 ↗</a>
              )
            }
          </div>
        </div>
      ))
    }
  </div>
</Base>
